<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Milo</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #080b12;
            color: white;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .milo {
            width: 90%;
            max-width: 500px;
            text-align: center;
        }

        h1 {
            font-size: 42px;
            letter-spacing: 6px;
        }

        .status {
            color: #8aa4ff;
            margin-bottom: 30px;
        }

        input {
            width: 70%;
            padding: 14px;
            border-radius: 10px;
            border: none;
            font-size: 16px;
        }

        button {
            padding: 14px 18px;
            margin: 6px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
        }

        #response {
            margin-top: 25px;
            min-height: 60px;
            line-height: 1.5;
        }
    </style>
</head>

<body>

<div class="milo">

    <h1>MILO</h1>

    <div class="status">ONLINE</div>

    <input
        id="command"
        type="text"
        placeholder="Talk to Milo..."
    >

    <br>

    <button onclick="askMilo()">Ask Milo</button>

    <button onclick="startListening()">🎙️</button>

    <div id="response">
        Ready, boss.
    </div>

</div>

<script src="script.js"></script>

</body>
</html>
<script src="script.js"></script>
